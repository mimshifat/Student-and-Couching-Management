rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 5 Rules: Finalized Data Validation & Security
    
    // Everything under the user's uid folder is owned by them
    match /users/{userId} {
      // Function to check if the user is suspended
      function isActive() {
        // Read the user document to check status
        let userDoc = get(/databases/$(database)/documents/users/$(userId));
        return userDoc == null || !('status' in userDoc.data) || (userDoc.data.status != 'suspended' && userDoc.data.status != 'inactive');
      }

      // 1. Ensure only the authenticated user can access their data
      // Allow them to read their own root document so the app knows their status
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow writes only if they own the path AND are not suspended
      allow write: if request.auth != null && request.auth.uid == userId && isActive();
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId && isActive();
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
